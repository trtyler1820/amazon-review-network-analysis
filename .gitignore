# Virtual environment
venv/

# Raw data — too large for GitHub (43GB). See README for download instructions.
data/raw/*
!data/raw/.gitkeep

# Cleaned data — regenerated by running scripts/clean_data.py
data/cleaned/*
!data/cleaned/.gitkeep

# macOS metadata
.DS_Store
**/.DS_Store

# Rationale internal doc
/docs/course_specs/project_rationale.md

# PM portfolio drafts (examples, not final)
/docs/DECISIONS.md
/docs/README_EXAMPLE.md

# Python artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Claude internal session state
.claude/

# SI 564 one-off scripts and output (not part of main project)
564/

# Jupyter checkpoint files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Editors
.vscode/
.idea/
*.swp
*.swo

# RAG pipeline artifacts — generated by scripts (too large for GitHub)
data/rag/
data/qdrant/
data/qdrant_sample
.env